# Copy to .env and fill in to connect to Meta. ./run.sh loads it. Never commit .env.
META_MODE=LIVE

# App Dashboard: top of the page
META_APP_ID=
# App Dashboard > App settings > Basic > App secret
META_APP_SECRET=
# App Dashboard > Facebook Login for Business > Configurations
META_CONFIG_ID=
META_GRAPH_VERSION=v26.0

# Any six digits; set as the two-step verification PIN on registered numbers
META_REGISTRATION_PIN=246810
